{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "ecc-universal",
    "@tarquinen/opencode-dcp@latest",
    "@morphllm/opencode-morph-plugin",
    "opencode-vibeguard"
  ],
  "instructions": [
    "AGENTS.md",
    "docs/wiki/ai/agent-entrypoint.md",
    "docs/wiki/ai/change-classification.md",
    "docs/wiki/ai/validation-matrix.md",
    "docs/wiki/ai/consistencia-codex.md",
    "docs/wiki/ai/engineering-advisor.md",
    "docs/wiki/reference/ai-contract.v1.yaml",
    "docs/wiki/reference/code-index.md"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    }
  },
  "permission": {
    "mcp_*": "ask"
  },
  "agent": {
    "build": {
      "permission": {
        "task": {
          "mica-checks": "allow"
        }
      }
    },
    "plan": {
      "permission": {
        "task": {
          "mica-checks": "allow"
        }
      }
    }
  }
}
