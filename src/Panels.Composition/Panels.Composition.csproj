<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <RootNamespace>Panels.Composition</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MicaAudio.Core\MicaAudio.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Cross-platform GIF/image decoder for server-side widget rendering.
         Q8-AnyCPU runs on Linux (Docker) without native libs. -->
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.15.0" />
  </ItemGroup>

</Project>
