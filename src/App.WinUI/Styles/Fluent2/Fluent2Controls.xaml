<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DOCS: docs/wiki/modules/app-winui.md#atualizacao-2026-03-menu-de-configuracao-fluent-2 -->
    <Style x:Key="AppHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="AppMutedTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}" />
    </Style>

    <Style x:Key="AppStatusTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource BrandAccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="AppChromeComboBoxStyle" TargetType="ComboBox">
        <Setter Property="MinHeight" Value="36" />
    </Style>

    <Style x:Key="AppBaseButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
    </Style>

    <Style x:Key="AppChromeButtonStyle" TargetType="Button" BasedOn="{StaticResource AppBaseButtonStyle}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="12,6" />
    </Style>

    <Style x:Key="AppIconButtonStyle" TargetType="Button" BasedOn="{StaticResource AppBaseButtonStyle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="AppSettingsPaneBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="18" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{ThemeResource AppSurfacePanelBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppSurfaceStrokeBrush}" />
    </Style>

    <Style x:Key="AppSettingsSectionBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="14" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{ThemeResource AppSurfaceElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppSurfaceStrokeBrush}" />
    </Style>

    <Style x:Key="AppSettingsSectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="AppSettingsSectionDescriptionTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="AppSettingsValueTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="AppChromeToggleSwitchStyle" TargetType="ToggleSwitch">
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
    </Style>

    <Style TargetType="NavigationView">
        <Setter Property="Background" Value="{ThemeResource AppSurfaceBaseBrush}" />
    </Style>

    <Style TargetType="NavigationViewItem">
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
    </Style>

    <Style TargetType="AppBarButton">
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
    </Style>

    <Style TargetType="AppBarToggleButton">
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
    </Style>

    <Style TargetType="SymbolIcon">
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
    </Style>

    <!-- Make TextBlock style explicit to avoid overriding other keyed text styles -->
    <Style x:Key="AppTextBlockStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
    </Style>
</ResourceDictionary>
