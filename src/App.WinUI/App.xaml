<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="App.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:App.WinUI.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Application.Resources>
        <ResourceDictionary>
            <DataTemplate x:Key="PanelGalleryCardTemplate">
                <controls:PanelGalleryCardControl />
            </DataTemplate>
            <SolidColorBrush x:Key="AppFallbackSurfaceBaseBrush" Color="#0B0F14" />

            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Styles/Fluent2/Fluent2Tokens.xaml" />
                <ResourceDictionary Source="Styles/Fluent2/Fluent2Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
