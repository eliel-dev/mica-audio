{
  "schemaVersion": 2,
  "apps": [
    {
      "id": "accuweather",
      "name": "Clima",
      "summary": "Previsão do tempo",
      "description": "Mostra condições e previsão do tempo para a cidade selecionada.",
      "author": "mica audio",
      "packageName": "accuweather",
      "fileName": "accuweather.star",
      "recommendedIntervalMinutes": 5,
      "category": "clima",
      "preview": {
        "kind": "weather",
        "speed": 1
      },
      "modifiers": [
        {
          "key": "city",
          "label": "Cidade",
          "type": "CityAutocomplete",
          "description": "Cidade base para consulta do clima.",
          "placeholder": "Ex: São Paulo",
          "defaultValue": "",
          "required": true
        },
        {
          "key": "units",
          "label": "Unidades",
          "type": "Select",
          "description": "Sistema de unidades de temperatura.",
          "defaultValue": "metric",
          "required": true,
          "options": [
            { "label": "Métrico (C)", "value": "metric" },
            { "label": "Imperial (F)", "value": "imperial" }
          ]
        },
        {
          "key": "lang",
          "label": "Idioma",
          "type": "Select",
          "description": "Idioma dos textos mostrados.",
          "defaultValue": "pt",
          "required": true,
          "options": [
            { "label": "Português", "value": "pt" },
            { "label": "English", "value": "en" },
            { "label": "Espanhol", "value": "es" }
          ]
        }
      ]
    },
    {
      "id": "analogclock",
      "name": "Relógio",
      "summary": "Relógio digital",
      "description": "Exibe a hora atual em estilo de painel HUB75.",
      "author": "mica audio",
      "packageName": "analogclock",
      "fileName": "analogclock.star",
      "recommendedIntervalMinutes": 0,
      "category": "relógio",
      "preview": {
        "kind": "clock",
        "speed": 1
      },
      "modifiers": [
        {
          "key": "timezone",
          "label": "Fuso horário",
          "type": "Text",
          "description": "Identificador IANA do fuso (ex: America/Sao_Paulo).",
          "placeholder": "America/Sao_Paulo",
          "defaultValue": "America/Sao_Paulo",
          "required": true
        },
        {
          "key": "format24h",
          "label": "Formato 24h",
          "type": "Toggle",
          "description": "Alterna entre formato 24h e 12h.",
          "required": false,
          "defaultToggle": true
        }
      ]
    }
  ]
}
