{
  "schemaVersion": 2,
  "apps": [
    {
      "id": "accuweather",
      "name": "Clima",
      "summary": "Previsão do tempo",
      "description": "Mostra cidade, temperatura e condição atual em formato HUB75.",
      "author": "Mica Audio",
      "packageName": "accuweather",
      "fileName": "accuweather.star",
      "recommendedIntervalMinutes": 5,
      "category": "clima",
      "preview": {
        "kind": "weather",
        "speed": 1
      },
      "modifiers": [
        {
          "key": "city",
          "label": "Cidade",
          "type": "CityAutocomplete",
          "description": "Cidade usada para consulta no Open-Meteo.",
          "placeholder": "Ex.: São Paulo",
          "defaultValue": "São Paulo, São Paulo, Brasil|-23.5505|-46.6333",
          "required": true
        },
        {
          "key": "units",
          "label": "Unidades",
          "type": "Select",
          "description": "Sistema de unidades de temperatura.",
          "defaultValue": "metric",
          "required": true,
          "options": [
            { "label": "Métrico (°C)", "value": "metric" },
            { "label": "Imperial (°F)", "value": "imperial" }
          ]
        }
      ]
    },
    {
      "id": "analogclock",
      "name": "Relógio",
      "summary": "Relógio digital HUB75",
      "description": "Exibe a hora de Brasília com watchfaces inspiradas em mostradores de smartwatch.",
      "author": "Mica Audio",
      "packageName": "analogclock",
      "fileName": "analogclock.star",
      "recommendedIntervalMinutes": 0,
      "category": "relógio",
      "preview": {
        "kind": "clock",
        "speed": 1
      },
      "modifiers": [
        {
          "key": "format24h",
          "label": "Formato 24h",
          "type": "Toggle",
          "description": "Alterna entre 24h e 12h.",
          "required": false,
          "defaultToggle": true
        },
        {
          "key": "watchfaceStyle",
          "label": "Estilo da watchface",
          "type": "Select",
          "description": "Define o estilo visual dos dígitos.",
          "defaultValue": "pixel",
          "required": true,
          "options": [
            { "label": "Pixel", "value": "pixel" },
            { "label": "Segmentado", "value": "segment" },
            { "label": "Arredondado", "value": "rounded" }
          ]
        },
        {
          "key": "fontColor",
          "label": "Cor da fonte",
          "type": "Select",
          "description": "Paleta pronta para os dígitos no painel.",
          "defaultValue": "cyan",
          "required": true,
          "options": [
            { "label": "Ciano", "value": "cyan" },
            { "label": "Branco", "value": "white" },
            { "label": "Verde", "value": "green" },
            { "label": "Amarelo", "value": "yellow" },
            { "label": "Laranja", "value": "orange" },
            { "label": "Magenta", "value": "magenta" }
          ]
        }
      ]
    }
  ]
}

