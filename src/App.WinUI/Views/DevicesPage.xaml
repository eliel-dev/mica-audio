<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="App.WinUI.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="16" RowSpacing="12" ColumnSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Gerar codigo pareamento" Click="OnGeneratePairingCodeClicked" />
            <Button Content="Atualizar" Click="OnRefreshClicked" />
            <Button Content="Entrar provisioning" Click="OnEnterProvisioningClicked" />
            <Button Content="Revogar/Reiniciar" Click="OnRevokeClicked" />
            <Button Content="Build stable + export" Click="OnBuildStableClicked" />
            <Button Content="Build dma_exp + export" Click="OnBuildDmaClicked" />
            <Button Content="Copiar host" Click="OnCopyHostClicked" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <ListView x:Name="DevicesList" SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding DeviceId}" Opacity="0.8" />
                            <TextBlock Text="{Binding StatusLine}" Opacity="0.8" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border Grid.Column="1" BorderBrush="{ThemeResource AppSurfaceStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="ServerInfoText" Text="Servidor: iniciando..." />
                    <TextBox x:Name="LogsTextBox" Grid.Row="1" AcceptsReturn="True" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="PairingCodeText" Grid.Row="2" Text="Pareamento: -" />
    </Grid>
</Page>
