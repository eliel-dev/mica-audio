<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="App.WinUI.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        Background="{ThemeResource AppSurfaceBaseBrush}"
        Padding="16"
        RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Background="{ThemeResource AppSurfaceElevatedBrush}"
            BorderBrush="{ThemeResource AppSurfaceStrokeBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="4">
            <CommandBar
                Background="Transparent"
                DefaultLabelPosition="Right"
                OverflowButtonVisibility="Auto">
                <AppBarButton Icon="Download" Label="Baixar firmware" Click="OnDownloadFirmwareClicked" />
                <AppBarButton Icon="Add" Label="Parear" Click="OnGeneratePairingCodeClicked" />
                <AppBarButton Icon="Refresh" Label="Atualizar" Click="OnRefreshClicked" />
                <AppBarButton Icon="Copy" Label="Copiar host" Click="OnCopyHostClicked" />
            </CommandBar>
        </Border>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Border
                Background="{ThemeResource AppSurfacePanelBrush}"
                BorderBrush="{ThemeResource AppSurfaceStrokeBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBox
                        x:Name="SearchBox"
                        Header="Buscar"
                        PlaceholderText="Nome, id, app ou status"
                        TextChanged="OnSearchTextChanged" />

                    <ListView
                        x:Name="DevicesList"
                        Grid.Row="1"
                        SelectionChanged="OnDeviceSelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                    <TextBlock Grid.Row="1" Opacity="0.82" Text="{Binding DeviceId}" />
                                    <TextBlock Grid.Row="2" Opacity="0.72" Text="{Binding StatusLine}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Background="{ThemeResource AppSurfacePanelBrush}"
                    BorderBrush="{ThemeResource AppSurfaceStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12">
                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Name="SelectedDeviceTitleText"
                            Style="{ThemeResource TitleTextBlockStyle}"
                            Text="Nenhum dispositivo selecionado" />
                        <TextBlock x:Name="SelectedDeviceSubtitleText" Opacity="0.82" Text="-" />
                        <TextBlock x:Name="SelectedDeviceAppText" Opacity="0.78" Text="App ativo: -" />
                        <TextBlock
                            x:Name="ServerInfoText"
                            Opacity="0.78"
                            Text="Servidor: iniciando..."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="1"
                    Background="{ThemeResource AppSurfacePanelBrush}"
                    BorderBrush="{ThemeResource AppSurfaceStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="8">
                    <CommandBar
                        Background="Transparent"
                        DefaultLabelPosition="Right"
                        OverflowButtonVisibility="Auto">
                        <AppBarButton
                            x:Name="EnterProvisioningButton"
                            Icon="Setting"
                            Label="Provisioning"
                            Click="OnEnterProvisioningClicked" />
                        <AppBarButton
                            x:Name="RevokeButton"
                            Icon="Undo"
                            Label="Revogar"
                            Click="OnRevokeClicked" />
                        <AppBarButton
                            x:Name="TestLedButton"
                            Icon="TouchPointer"
                            Label="Testar LED"
                            Click="OnTestLedClicked" />                    </CommandBar>
                </Border>

                <Border
                    Grid.Row="2"
                    Background="{ThemeResource AppSurfacePanelBrush}"
                    BorderBrush="{ThemeResource AppSurfaceStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressRing
                            x:Name="CommandProgressRing"
                            Width="18"
                            Height="18"
                            IsActive="False"
                            Visibility="Collapsed"
                            VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="CommandStatusText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="Comandos: pronto"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="CommandPercentText"
                            Grid.Column="2"
                            Opacity="0.82"
                            VerticalAlignment="Center"
                            Text="0%" />
                    </Grid>
                </Border>

                <Border
                    Grid.Row="3"
                    Background="{ThemeResource AppSurfacePanelBrush}"
                    BorderBrush="{ThemeResource AppSurfaceStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12">
                    <TextBox
                        x:Name="LogsTextBox"
                        AcceptsReturn="True"
                        Header="Logs"
                        IsReadOnly="True"
                        MinHeight="200"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />
                </Border>
            </Grid>
        </Grid>

        <InfoBar
            x:Name="PairingCodeText"
            Grid.Row="2"
            IsClosable="False"
            IsOpen="True"
            Message="Pareamento: -"
            Severity="Informational" />
    </Grid>
</Page>

