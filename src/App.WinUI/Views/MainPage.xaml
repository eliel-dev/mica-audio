<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="App.WinUI.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <!-- DOCS: docs/wiki/modules/app-winui.md#atualizacao-2026-03-menu-de-configuracao-fluent-2 -->

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F11" Invoked="OnFullscreenAcceleratorInvoked" />
        <KeyboardAccelerator Key="Escape" Invoked="OnFullscreenAcceleratorInvoked" />
        <KeyboardAccelerator Key="Left" Invoked="OnPreviousPresetAcceleratorInvoked" />
        <KeyboardAccelerator Key="Right" Invoked="OnNextPresetAcceleratorInvoked" />
        <KeyboardAccelerator Key="D" Modifiers="Control,Shift" Invoked="OnRenderDiagnosticsAcceleratorInvoked" />
    </Page.KeyboardAccelerators>

    <SplitView
        x:Name="SettingsSplitView"
        Background="{ThemeResource AppSurfaceBaseBrush}"
        CompactPaneLength="0"
        DisplayMode="Inline"
        IsPaneOpen="False"
        OpenPaneLength="420"
        PanePlacement="Right">
        <SplitView.Transitions>
            <TransitionCollection>
                <RepositionThemeTransition />
            </TransitionCollection>
        </SplitView.Transitions>

        <SplitView.Pane>
            <Border
                x:Name="SettingsPaneRoot"
                Margin="10,10,0,10"
                Style="{StaticResource AppSettingsPaneBorderStyle}">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource AppHeaderTextStyle}" Text="Configurações" />
                            <TextBlock
                                x:Name="SettingsPaneSubtitleText"
                                Style="{StaticResource AppMutedTextStyle}"
                                Text="Ajuste renderização, análise e frequência do visualizador."
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            Width="32"
                            Height="32"
                            VerticalAlignment="Top"
                            Style="{StaticResource AppIconButtonStyle}"
                            Click="OnSettingsPaneCloseClicked"
                            ToolTipService.ToolTip="Fechar configurações">
                            <SymbolIcon Symbol="Cancel" />
                        </Button>
                    </Grid>

                    <ScrollViewer
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto"
                        VerticalScrollMode="Enabled">
                        <StackPanel Spacing="14">
                            <Border Style="{StaticResource AppSettingsSectionBorderStyle}">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="2">
                                        <TextBlock Style="{StaticResource AppSettingsSectionTitleTextStyle}" Text="Renderização" />
                                        <TextBlock
                                            Style="{StaticResource AppSettingsSectionDescriptionTextStyle}"
                                            Text="Defina o contexto visual do preset atual e como o conteúdo é desenhado."
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Preset atual" />
                                            <TextBlock
                                                Style="{StaticResource AppMutedTextStyle}"
                                                Text="Use as setas esquerda e direita para navegar rapidamente."
                                                TextWrapping="Wrap" />
                                        </StackPanel>

                                        <TextBlock
                                            x:Name="CurrentPresetNameText"
                                            Grid.Column="1"
                                            MaxWidth="170"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource AppSettingsValueTextStyle}"
                                            Text="AudioMotion Clone"
                                            TextAlignment="Right"
                                            TextWrapping="Wrap" />
                                    </Grid>

                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="190" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Renderizador" />
                                            <TextBlock
                                                x:Name="RendererHintText"
                                                Style="{StaticResource AppMutedTextStyle}"
                                                Text="Escolhe como o visualizador é desenhado no canvas principal."
                                                TextWrapping="Wrap" />
                                        </StackPanel>

                                        <ComboBox
                                            x:Name="RendererCombo"
                                            Grid.Column="1"
                                            MinWidth="190"
                                            HorizontalAlignment="Stretch"
                                            Style="{StaticResource AppChromeComboBoxStyle}"
                                            SelectionChanged="OnRendererSelectionChanged" />
                                    </Grid>

                                    <Grid
                                        x:Name="ContentModeSettingRow"
                                        ColumnSpacing="16"
                                        Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="190" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Origem do conteúdo" />
                                            <TextBlock
                                                Style="{StaticResource AppMutedTextStyle}"
                                                Text="Alterna entre áudio ao vivo e reprodução de GIF quando houver mídia carregada."
                                                TextWrapping="Wrap" />
                                        </StackPanel>

                                        <ComboBox
                                            x:Name="ContentModeCombo"
                                            Grid.Column="1"
                                            MinWidth="190"
                                            HorizontalAlignment="Stretch"
                                            Style="{StaticResource AppChromeComboBoxStyle}"
                                            SelectionChanged="OnContentModeSelectionChanged" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource AppSettingsSectionBorderStyle}">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="2">
                                        <TextBlock Style="{StaticResource AppSettingsSectionTitleTextStyle}" Text="Análise" />
                                        <TextBlock
                                            Style="{StaticResource AppSettingsSectionDescriptionTextStyle}"
                                            Text="Controle a densidade visual e o comportamento do espectro."
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Grid x:Name="BarCountPanel" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="190" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Quantidade de barras" />
                                            <TextBlock
                                                x:Name="CloneBarsHintText"
                                                Style="{StaticResource AppMutedTextStyle}"
                                                Text="No modo AudioMotion Clone, a quantidade de barras é automática pela largura da tela."
                                                TextWrapping="Wrap" />
                                        </StackPanel>

                                        <Grid Grid.Column="1" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Slider
                                                x:Name="BarCountSlider"
                                                Grid.Column="0"
                                                Maximum="128"
                                                Minimum="0"
                                                SmallChange="1"
                                                StepFrequency="1"
                                                ValueChanged="OnBarCountChanged" />
                                            <TextBlock
                                                x:Name="BarCountValueText"
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource AppSettingsValueTextStyle}"
                                                Text="38" />
                                        </Grid>
                                    </Grid>

                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="190" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="2">
                                            <TextBlock Text="FFT smoothing" />
                                            <TextBlock
                                                Style="{StaticResource AppMutedTextStyle}"
                                                Text="Suaviza oscilações rápidas para deixar a resposta visual mais estável."
                                                TextWrapping="Wrap" />
                                        </StackPanel>

                                        <Grid Grid.Column="1" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="FftSmoothingSlider" Grid.Column="0" ValueChanged="OnFftSmoothingChanged" />
                                            <TextBlock
                                                x:Name="FftSmoothingValueText"
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource AppSettingsValueTextStyle}"
                                                Text="0.80" />
                                        </Grid>
                                    </Grid>

                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="190" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Filtro de weighting" />
                                            <TextBlock
                                                Style="{StaticResource AppMutedTextStyle}"
                                                Text="Aplica uma curva psicoacústica para privilegiar faixas mais percebidas pelo ouvido."
                                                TextWrapping="Wrap" />
                                        </StackPanel>

                                        <ComboBox
                                            x:Name="WeightingFilterCombo"
                                            Grid.Column="1"
                                            MinWidth="190"
                                            HorizontalAlignment="Stretch"
                                            Style="{StaticResource AppChromeComboBoxStyle}"
                                            ToolTipService.ToolTip="Aplica curva psicoacústica por frequência (A, B, C, D ou 468)."
                                            SelectionChanged="OnWeightingFilterChanged" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource AppSettingsSectionBorderStyle}">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="2">
                                        <TextBlock Style="{StaticResource AppSettingsSectionTitleTextStyle}" Text="Frequência" />
                                        <TextBlock
                                            Style="{StaticResource AppSettingsSectionDescriptionTextStyle}"
                                            Text="Defina a escala e a faixa do espectro usada no visualizador."
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="190" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Escala de frequência" />
                                            <TextBlock
                                                Style="{StaticResource AppMutedTextStyle}"
                                                Text="Escolhe como as barras são distribuídas ao longo do espectro."
                                                TextWrapping="Wrap" />
                                        </StackPanel>

                                        <ComboBox
                                            x:Name="FrequencyScaleCombo"
                                            Grid.Column="1"
                                            MinWidth="190"
                                            HorizontalAlignment="Stretch"
                                            Style="{StaticResource AppChromeComboBoxStyle}"
                                            ToolTipService.ToolTip="Define como as barras são distribuídas no espectro."
                                            SelectionChanged="OnFrequencyScaleChanged" />
                                    </Grid>

                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="190" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Faixa de frequência" />
                                            <TextBlock
                                                Style="{StaticResource AppMutedTextStyle}"
                                                Text="Limita a janela analisada para destacar a região do áudio que interessa."
                                                TextWrapping="Wrap" />
                                        </StackPanel>

                                        <Grid Grid.Column="1" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox
                                                x:Name="FrequencyMinCombo"
                                                Grid.Column="0"
                                                Style="{StaticResource AppChromeComboBoxStyle}"
                                                ToolTipService.ToolTip="Frequência mínima analisada."
                                                SelectionChanged="OnFrequencyMinChanged" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource AppMutedTextStyle}"
                                                Text="até" />
                                            <ComboBox
                                                x:Name="FrequencyMaxCombo"
                                                Grid.Column="2"
                                                Style="{StaticResource AppChromeComboBoxStyle}"
                                                ToolTipService.ToolTip="Frequência máxima analisada."
                                                SelectionChanged="OnFrequencyMaxChanged" />
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource AppSettingsSectionBorderStyle}">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="2">
                                        <TextBlock Style="{StaticResource AppSettingsSectionTitleTextStyle}" Text="Ações" />
                                        <TextBlock
                                            Style="{StaticResource AppSettingsSectionDescriptionTextStyle}"
                                            Text="Use quando quiser voltar rapidamente ao conjunto recomendado."
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Button
                                        x:Name="ResetSettingsButton"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource AppChromeButtonStyle}"
                                        Click="OnResetSettingsClicked"
                                        Content="Restaurar padrão"
                                        ToolTipService.ToolTip="Restaura os parâmetros visuais e de análise para os valores recomendados." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </SplitView.Pane>

        <SplitView.Content>
            <Grid
                x:Name="VisualizerLayout"
                Margin="12,0,12,12"
                Background="{ThemeResource AppSurfaceBaseBrush}"
                SizeChanged="OnVisualizerLayoutSizeChanged">
                <Grid.Transitions>
                    <TransitionCollection>
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </Grid.Transitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition x:Name="HubPreviewRow" Height="0" />
                </Grid.RowDefinitions>

                                <Border
                    x:Name="ControlsPanel"
                    Grid.Row="0"
                    Margin="0,10,0,10"
                    Background="{ThemeResource AppSurfaceElevatedBrush}"
                    BorderBrush="{ThemeResource AppSurfaceStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="4">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <CommandBar
                            Grid.Column="0"
                            Background="Transparent"
                            DefaultLabelPosition="Right"
                            IsDynamicOverflowEnabled="True"
                            OverflowButtonVisibility="Auto">
                            <AppBarToggleButton
                                x:Name="SettingsButton"
                                Icon="Setting"
                                Label="Configurações"
                                Click="OnSettingsClicked" />
                            <AppBarSeparator />
                            <AppBarElementContainer>
                                <ToggleSwitch
                                    x:Name="Hub75Toggle"
                                    Header="Modo HUB75"
                                    Style="{StaticResource AppChromeToggleSwitchStyle}"
                                    Toggled="OnHub75Toggled" />
                            </AppBarElementContainer>
                        </CommandBar>

                        <TextBlock
                            x:Name="StatusText"
                            Grid.Column="1"
                            Margin="10,0,8,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource AppStatusTextStyle}"
                            Text="Parado" />
                    </Grid>
                </Border>

                <Border
                    x:Name="GifControlsPanel"
                    Grid.Row="1"
                    Margin="0,0,0,10"
                    Padding="10"
                    Background="{ThemeResource AppSurfacePanelBrush}"
                    BorderBrush="{ThemeResource AppSurfaceStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="Collapsed">
                    <StackPanel Spacing="10">
                        <Button
                            x:Name="GifOpenFileButton"
                            Style="{StaticResource AppChromeButtonStyle}"
                            Click="OnGifOpenFileClicked"
                            Content="Abrir GIF" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="GifScaleModeCombo"
                                Grid.Column="0"
                                Width="130"
                                SelectionChanged="OnGifScaleModeSelectionChanged" />
                            <Button
                                x:Name="GifPlayButton"
                                Grid.Column="1"
                                Margin="6,0,0,0"
                                Style="{StaticResource AppChromeButtonStyle}"
                                Click="OnGifPlayClicked"
                                Content="Play" />
                            <Button
                                x:Name="GifPauseButton"
                                Grid.Column="2"
                                Margin="6,0,0,0"
                                Style="{StaticResource AppChromeButtonStyle}"
                                Click="OnGifPauseClicked"
                                Content="Pause" />
                            <Button
                                x:Name="GifStopButton"
                                Grid.Column="3"
                                Margin="6,0,0,0"
                                Style="{StaticResource AppChromeButtonStyle}"
                                Click="OnGifStopClicked"
                                Content="Stop" />
                            <ProgressRing
                                x:Name="GifLoadingRing"
                                Grid.Column="4"
                                Width="20"
                                Height="20"
                                Margin="10,0,0,0"
                                IsActive="False"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="GifFirmwareCompatibilityText"
                                Grid.Column="5"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource AppMutedTextStyle}"
                                Text="Aviso: firmware antigo ignora frame RGB565 (tipo 2). O preview local continua funcionando."
                                TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border
                    x:Name="MainCanvasBorder"
                    Grid.Row="2"
                    Margin="0,0,0,10"
                    Background="Black"
                    CornerRadius="12"
                    PointerEntered="OnMainCanvasHostPointerEntered"
                    PointerExited="OnMainCanvasHostPointerExited"
                    PointerMoved="OnMainCanvasHostPointerMoved">
                    <Grid>
                        <canvas:CanvasControl
                            x:Name="MainCanvas"
                            Draw="OnMainCanvasDraw"
                            DoubleTapped="OnMainCanvasDoubleTapped"
                            SizeChanged="OnMainCanvasSizeChanged" />
                        <Border
                            x:Name="PresetQuickSwitchHud"
                            Margin="0,14,0,0"
                            Padding="10,6"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Background="{ThemeResource AppSurfaceElevatedBrush}"
                            BorderBrush="{ThemeResource AppSurfaceStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="PresetQuickSwitchText"
                                Style="{StaticResource AppStatusTextStyle}"
                                Text="01. Preset" />
                        </Border>
                        <Border
                            x:Name="RenderDiagnosticsHud"
                            Margin="14"
                            Padding="10,8"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="{ThemeResource AppSurfaceElevatedBrush}"
                            BorderBrush="{ThemeResource AppSurfaceStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="RenderDiagnosticsText"
                                Style="{StaticResource AppMutedTextStyle}"
                                Text="FPS --" />
                        </Border>
                        <Button
                            x:Name="CanvasFullscreenButton"
                            Width="40"
                            Height="40"
                            Margin="0,0,14,14"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Click="OnFullscreenClicked"
                            IsHitTestVisible="False"
                            Opacity="0.92"
                            Style="{StaticResource AppIconButtonStyle}"
                            ToolTipService.ToolTip="Tela cheia (F11). Em tela cheia, mova o mouse para exibir este botao."
                            Visibility="Collapsed">
                            <PathIcon
                                x:Name="CanvasFullscreenIcon"
                                Data="M2,2 H10 V4 H4 V10 H2 Z M14,2 H22 V10 H20 V4 H14 Z M14,22 H22 V14 H20 V20 H14 Z M2,14 H4 V20 H10 V22 H2 Z" />
                        </Button>
                    </Grid>
                </Border>

                <Border
                    x:Name="HubPreviewPanel"
                    Grid.Row="3"
                    Padding="10"
                    Background="{ThemeResource AppSurfacePanelBrush}"
                    BorderBrush="{ThemeResource AppSurfaceStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="Collapsed">
                    <Border.Transitions>
                        <TransitionCollection>
                            <RepositionThemeTransition />
                        </TransitionCollection>
                    </Border.Transitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Margin="0,0,0,8"
                            Style="{StaticResource AppStatusTextStyle}"
                            Text="Simulacao HUB75 local (128x64 nativo)" />
                        <Grid Grid.Row="1" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.ColumnSpan="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Margin="0,0,0,6"
                                    Style="{StaticResource AppMutedTextStyle}"
                                    Text="128x64" />
                                <canvas:CanvasControl
                                    x:Name="HubCanvas"
                                    Grid.Row="1"
                                    Draw="OnHubCanvasDraw" />
                            </Grid>

                            </Grid>
                    </Grid>
                </Border>

            </Grid>
        </SplitView.Content>
    </SplitView>
</Page>














