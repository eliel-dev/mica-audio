<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="App.WinUI.Views.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        Background="{ThemeResource AppSurfaceBaseBrush}"
        Padding="16"
        RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Background="{ThemeResource AppSurfaceElevatedBrush}"
            BorderBrush="{ThemeResource AppSurfaceStrokeBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="4">
            <CommandBar Background="Transparent" DefaultLabelPosition="Right">
                <AppBarButton Icon="Refresh" Label="Recarregar" Click="OnReloadCatalogClicked" />
                <AppBarSeparator />
                <AppBarElementContainer>
                    <TextBox
                        x:Name="SearchBox"
                        MinWidth="320"
                        PlaceholderText="Buscar por nome, categoria ou autor"
                        TextChanged="OnSearchTextChanged" />
                </AppBarElementContainer>
            </CommandBar>
        </Border>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border
                Background="{ThemeResource AppSurfacePanelBrush}"
                BorderBrush="{ThemeResource AppSurfaceStrokeBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Catálogo de apps" />

                    <GridView
                        x:Name="CatalogGrid"
                        Grid.Row="1"
                        Margin="0,10,0,0"
                        IsItemClickEnabled="True"
                        ItemClick="OnCatalogItemClick"
                        SelectionMode="Single">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Width="240"
                                    Padding="12"
                                    Margin="0,0,10,10"
                                    Background="{ThemeResource AppSurfaceElevatedBrush}"
                                    BorderBrush="{ThemeResource AppSurfaceStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                    <StackPanel Spacing="4">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="Wrap" />
                                        <TextBlock Opacity="0.82" Text="{Binding Summary}" TextWrapping="Wrap" />
                                        <TextBlock Opacity="0.72" Text="{Binding Category}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Background="{ThemeResource AppSurfacePanelBrush}"
                    BorderBrush="{ThemeResource AppSurfaceStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12">
                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Name="SelectedAppNameText"
                            Style="{ThemeResource TitleTextBlockStyle}"
                            Text="Selecione um app" />
                        <TextBlock x:Name="SelectedAppMetaText" Opacity="0.82" Text="-" TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="SelectedAppDescriptionText"
                            Opacity="0.9"
                            Text="Nenhum app selecionado."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="1"
                    Background="{ThemeResource AppSurfacePanelBrush}"
                    BorderBrush="{ThemeResource AppSurfaceStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="8">
                    <CommandBar Background="Transparent" DefaultLabelPosition="Right">
                        <AppBarElementContainer>
                            <ComboBox
                                x:Name="TargetDeviceCombo"
                                MinWidth="220"
                                PlaceholderText="Dispositivo online" />
                        </AppBarElementContainer>
                        <AppBarButton Icon="Download" Label="Instalar" Click="OnInstallClicked" />
                        <AppBarButton Icon="Accept" Label="Ativar" Click="OnActivateClicked" />
                    </CommandBar>
                </Border>

                <Border
                    Grid.Row="2"
                    Background="{ThemeResource AppSurfacePanelBrush}"
                    BorderBrush="{ThemeResource AppSurfaceStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressRing
                            x:Name="OperationProgressRing"
                            Width="18"
                            Height="18"
                            IsActive="False"
                            VerticalAlignment="Center"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="OperationStatusText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="Operações: pronto"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="OperationPercentText"
                            Grid.Column="2"
                            Opacity="0.82"
                            VerticalAlignment="Center"
                            Text="0%" />
                    </Grid>
                </Border>

                <Border
                    Grid.Row="3"
                    Background="{ThemeResource AppSurfacePanelBrush}"
                    BorderBrush="{ThemeResource AppSurfaceStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12">
                    <TextBox
                        x:Name="LogsTextBox"
                        AcceptsReturn="True"
                        Header="Histórico"
                        IsReadOnly="True"
                        MinHeight="170"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
