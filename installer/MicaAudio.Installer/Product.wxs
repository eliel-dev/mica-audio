<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Mica Audio"
           Manufacturer="Mica Audio"
           Version="$(var.ProductVersion)"
           UpgradeCode="{7A0CB1F7-BDCB-4E4E-BF51-E1334A449FCA}"
           Language="1046"
           Scope="perMachine"
           InstallerVersion="500">
    <MajorUpgrade DowngradeErrorMessage="Ja existe uma versao mais recente do [ProductName]." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="MicaAudio" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="MicaAudioProgramMenuDir" Name="Mica Audio" />
    </StandardDirectory>

    <ComponentGroup Id="MainApplicationFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>

    <Component Id="StartMenuShortcutComponent"
               Directory="MicaAudioProgramMenuDir"
               Guid="{B9661393-5C5C-498F-ADCF-726B0AE7AD86}">
      <Shortcut Id="StartMenuShortcut"
                Name="Mica Audio"
                Description="Visualizador de audio em tempo real"
                Target="[INSTALLFOLDER]App.WinUI.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveMicaAudioProgramMenuDir" On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\MicaAudio"
                     Name="Installed"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <Feature Id="MainFeature" Title="Mica Audio" Level="1">
      <ComponentGroupRef Id="MainApplicationFiles" />
      <ComponentRef Id="StartMenuShortcutComponent" />
    </Feature>
  </Package>
</Wix>
