<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:netfx="http://wixtoolset.org/schemas/v4/wxs/netfx">
  <Bundle Name="Mica Audio"
          Manufacturer="Mica Audio"
          Version="$(var.ProductVersion)"
          UpgradeCode="{7B126003-557C-4576-BB5F-819DEC3347F1}">

    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication Theme="hyperlinkLicense"
                                              LicenseUrl="https://github.com/mica-audio/mica-audio/blob/main/README.md" />
    </BootstrapperApplication>

    <netfx:DotNetCoreSearch RuntimeType="desktop"
                            Platform="x64"
                            MajorVersion="8"
                            Variable="DOTNET_DESKTOP_RUNTIME_8_X64" />

    <Chain>
      <ExePackage Id="DotNetDesktopRuntime8x64"
                  DisplayName=".NET Desktop Runtime 8 (x64)"
                  SourceFile="$(var.DotNetDesktopRuntimeInstaller)"
                  DetectCondition="DOTNET_DESKTOP_RUNTIME_8_X64"
                  InstallArguments="/install /quiet /norestart"
                  RepairArguments="/repair /quiet /norestart"
                  UninstallArguments="/uninstall /quiet /norestart"
                  PerMachine="yes"
                  Vital="yes"
                  Compressed="yes" />

      <MsiPackage Id="MicaAudioMsi"
                  DisplayName="Mica Audio"
                  SourceFile="$(var.MsiPath)"
                  Compressed="yes"
                  Visible="no"
                  Vital="yes" />
    </Chain>
  </Bundle>
</Wix>
